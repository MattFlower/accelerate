diff --git a/test/bulk.test.mjs b/test/bulk.test.mjs
new file mode 100644
index 0000000..0d10d61
--- /dev/null
+++ b/test/bulk.test.mjs
@@ -0,0 +1,48 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { OrderStore } from '../src/storage/orders.mjs';
+import { OrderService } from '../src/orders/service.mjs';
+
+function setup() {
+  const store = new OrderStore({ capacity: 2 });
+  store.insert({ id: 'a', total: 10 });
+  store.insert({ id: 'b', total: 20 });
+  store.readMetrics({ reset: true });
+  return new OrderService(store);
+}
+
+test('batch reads retain order, duplicates and missing positions', () => {
+  const service = setup();
+  assert.deepEqual(service.getMany(['b', 'missing', 'a', 'b']).map(row => row?.id),
+    ['b', undefined, 'a', 'b']);
+  assert.deepEqual(service.getMany([]), []);
+  assert.equal(service.readMetrics().hits, 3);
+  assert.equal(service.readMetrics().misses, 1);
+});
+
+test('batch validation happens before any reads', () => {
+  const service = setup();
+  for (const ids of [null, ['a', 2], Array(101).fill('a')]) {
+    assert.throws(() => service.getMany(ids));
+  }
+  assert.equal(service.readMetrics().hits, 0);
+});
+
+test('metrics reset leaves cache contents warm', () => {
+  const service = setup();
+  service.getMany(['a', 'b']);
+  const before = service.readMetrics({ reset: true });
+  assert.equal(before.hitRate, 1);
+  assert.equal(before.size, 2);
+  assert.equal(service.readMetrics().hitRate, 0);
+  service.get('a');
+  assert.equal(service.readMetrics().hits, 1);
+});
+
+test('evictions count capacity pressure rather than replacements', () => {
+  const service = setup();
+  service.store.cache.set('a', { id: 'a' });
+  service.store.cache.set('c', { id: 'c' });
+  assert.equal(service.readMetrics().writes, 2);
+  assert.equal(service.readMetrics().evictions, 1);
+});
