diff --git a/test/operations.test.mjs b/test/operations.test.mjs
new file mode 100644
index 0000000..b6dbf41
--- /dev/null
+++ b/test/operations.test.mjs
@@ -0,0 +1,45 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { Scheduler } from '../src/retry/scheduler.mjs';
+import { retryDelay, operationPolicy } from '../src/retry/policy.mjs';
+
+const defaults = { baseMs: 100, capMs: 1000, maxAttempts: 4 };
+const fail = async () => { throw { retryable: true }; };
+
+test('operation delays resolve independently with a shared ceiling', () => {
+  assert.equal(retryDelay(3), 300);
+  assert.equal(retryDelay(3, { strategy: 'exponential' }), 400);
+  assert.equal(retryDelay(30, defaults), 1000);
+  assert.equal(operationPolicy(defaults, { maxAttempts: 2 }).baseMs, 100);
+  assert.throws(() => operationPolicy(defaults, { strategy: 'random' }));
+  assert.throws(() => operationPolicy(defaults, { capMs: 1 }));
+  assert.throws(() => operationPolicy(defaults, { typo: 1 }));
+});
+
+test('mixed operations schedule using their own budgets and delays', async () => {
+  let now = 0;
+  const queue = new Scheduler(defaults, () => now, {
+    fast: { baseMs: 10, maxAttempts: 2 },
+    slow: { strategy: 'exponential', baseMs: 200 },
+  });
+  queue.enqueue('a', {}, 'fast');
+  queue.enqueue('b', {}, 'slow');
+  await queue.tick(fail);
+  assert.deepEqual(queue.snapshot().pending.map(job => job.due), [10, 200]);
+  now = 10;
+  await queue.tick(fail);
+  assert.equal(queue.snapshot().finished[0].id, 'a');
+  assert.equal(queue.snapshot().pending[0].id, 'b');
+  assert.throws(() => queue.enqueue('c', {}, 'unknown'));
+});
+
+test('caller edits cannot alter a resolved operation policy', async () => {
+  const overrides = { mail: { baseMs: 50 } };
+  const queue = new Scheduler(defaults, () => 0, overrides);
+  queue.enqueue('a', {}, 'mail');
+  overrides.mail.baseMs = 900;
+  const snapshot = queue.snapshot();
+  snapshot.pending[0].policy.baseMs = 800;
+  await queue.tick(fail);
+  assert.equal(queue.snapshot().pending[0].due, 50);
+});
