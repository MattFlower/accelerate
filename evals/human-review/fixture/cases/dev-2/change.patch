--- /dev/null
+++ b/src/orders/tokens.mjs
@@ -0,0 +1,15 @@
+/** Bound replay identifiers before they reach the process-local index. */
+export function normalizeToken(token) {
+  if (token === undefined || token === null) return undefined;
+  if (typeof token !== 'string') throw new Error('token must be text');
+  const normalized = token.trim();
+  if (normalized.length > 128) throw new Error('token is too long');
+  if (/[\x00-\x1f\x7f]/.test(normalized)) throw new Error('token contains control characters');
+  return normalized || undefined;
+}
+
+export function tokenDeadline(now, ttlMs) {
+  if (!Number.isSafeInteger(ttlMs) || ttlMs < 1) throw new Error('invalid token lifetime');
+  if (!Number.isSafeInteger(now + ttlMs)) throw new Error('invalid token deadline');
+  return now + ttlMs;
+}
