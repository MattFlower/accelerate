+export function retryDelay(attempt, { baseMs = 100, capMs = 10000, strategy = 'linear' } = {}) {
   if (!Number.isInteger(attempt) || attempt < 1) throw new Error('invalid attempt');
-  return Math.min(capMs, baseMs * 2 ** (attempt - 1));
+  const factor = strategy === 'exponential' ? 2 ** (attempt - 1) : attempt;
