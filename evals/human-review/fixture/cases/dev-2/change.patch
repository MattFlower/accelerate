diff --git a/test/tokens.test.mjs b/test/tokens.test.mjs
new file mode 100644
index 0000000..f2dd385
--- /dev/null
+++ b/test/tokens.test.mjs
@@ -0,0 +1,54 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { OrderStore } from '../src/storage/orders.mjs';
+import { OrderService } from '../src/orders/service.mjs';
+import { normalizeToken } from '../src/orders/tokens.mjs';
+
+const input = { customer: 'A', items: [{ sku: 'x', price: 1, quantity: 1 }] };
+function setup() {
+  let now = 0;
+  let id = 0;
+  const store = new OrderStore();
+  const service = new OrderService(store, {
+    clock: () => now, nextId: () => String(++id), tokenTtlMs: 100,
+  });
+  return { store, service, advance: time => { now = time; } };
+}
+
+test('token lifetime includes replay before but not at the deadline', () => {
+  const { service, store, advance } = setup();
+  const first = service.submit(input, 'request');
+  advance(99);
+  assert.equal(service.submit(input, 'request').order.id, first.order.id);
+  advance(100);
+  assert.equal(service.submit(input, 'request').created, true);
+  assert.equal(store.count(), 2);
+});
+
+test('pruning expires identities without removing their orders', () => {
+  const { service, store } = setup();
+  service.submit(input, 'a');
+  assert.equal(store.pruneTokens(99), 0);
+  assert.equal(store.pruneTokens(100), 1);
+  assert.equal(store.pruneTokens(101), 0);
+  assert.equal(store.count(), 1);
+});
+
+test('invalid tokens fail before creating a row', () => {
+  const { service, store } = setup();
+  for (const token of [42, 'a'.repeat(129), 'a\u0000b']) {
+    assert.throws(() => service.submit(input, token));
+  }
+  assert.equal(store.count(), 0);
+  assert.equal(normalizeToken(undefined), undefined);
+  assert.equal(normalizeToken('valid'), 'valid');
+});
+
+test('replay does not extend the original expiry', () => {
+  const { service, advance } = setup();
+  service.submit(input, 'a');
+  advance(50);
+  service.submit(input, 'a');
+  advance(100);
+  assert.equal(service.submit(input, 'a').created, true);
+});
